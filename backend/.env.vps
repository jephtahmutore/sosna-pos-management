# ─── VPS Environment Variables ───────────────────────────────────────────────
# Rename/copy this file to .env on the VPS at /var/www/sosna-pos-tenant/backend/.env

NODE_ENV=production
PORT=5300
TENANT_PORT=5301

# JWT secret — change this to a long random string (keep it secret!)
JWT_SECRET=change-this-to-a-long-random-secret-string-2026

# Per-tenant SQLite DB files live under this directory (one .db per tenant slug)
TENANTS_DIR=/var/www/sosna-pos-tenant/tenants

# Master DB tracks registered tenants and licenses
MASTER_DB_PATH=/var/www/sosna-pos-tenant/master.db

# Path for uploaded product images (per-tenant subfolders are created inside)
UPLOADS_DIR=/var/www/sosna-pos-tenant/tenants

# Admin panel password — change this before deploying!
ADMIN_PASSWORD=change-this-admin-password-2026
